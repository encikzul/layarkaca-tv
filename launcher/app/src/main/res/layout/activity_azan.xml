<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/azanPanel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/azanBars"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:importantForAccessibility="no">
            <View android:layout_width="4dp" android:layout_height="10dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="19dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="28dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="23dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="12dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
            <View android:layout_width="4dp" android:layout_height="20dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/azan_bar" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:includeFontPadding="false"
            android:text="TELAH MASUK WAKTU"
            android:textColor="#B8F4F6F5"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400" />

        <TextView
            android:id="@+id/azanName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:textColor="#FFF4F6F5"
            android:textSize="48sp"
            android:letterSpacing="-0.02"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <TextView
            android:id="@+id/azanTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:textColor="#D9F4F6F5"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="Ditutup sendiri selepas 30 saat."
            android:textColor="#C7F4F6F5"
            android:textSize="11sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/azanClose"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@+id/azanMute"
                android:includeFontPadding="false"
                android:text="Tutup"
                android:textColor="#FFF4F6F5"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/azanMute"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/azanClose"
                android:includeFontPadding="false"
                android:text="Senyapkan hari ini"
                android:textColor="#FFF4F6F5"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/azanNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:includeFontPadding="false"
        android:textColor="#9EF4F6F5"
        android:textSize="9sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400" />
</FrameLayout>
