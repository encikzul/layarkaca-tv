<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The prayer-time panel (AzanActivity), drawn over whatever is on screen. -->
    <style name="Theme.TvHome.Azan" parent="android:Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <!-- Android 12: blur what is behind, where the TV allows it; else the dim alone. -->
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">40dp</item>
    </style>
</resources>
